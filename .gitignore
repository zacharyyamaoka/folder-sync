/app/src-tauri/target/
/app/src-tauri/binaries/
/app/src-tauri/gen/
# The dev view's generated page (scripts/status, docs/DEV-VIEW.md)
/site/dev/
# gates.json and its evidence (scripts/gates): rewritten on every run
/reports/status/
