 // Fallback is the safety-net round interval while both push sources are live (PEP 0005 §2.5).
-const Fallback = 60 * time.Second
+// FOLDER_SYNC_FALLBACK (a Go duration) overrides it for the bench (bench/fast/patches; never committed).
+var Fallback = EnvDuration("FOLDER_SYNC_FALLBACK", 60*time.Second)
+
+// EnvDuration is the positive Go duration in the environment variable name, else def.
+func EnvDuration(name string, def time.Duration) time.Duration {
+	if d, err := time.ParseDuration(os.Getenv(name)); err == nil && d > 0 {
+		return d
+	}
+	return def
+}
 
