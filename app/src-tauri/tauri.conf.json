{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "folder-sync",
  "mainBinaryName": "folder-sync-desktop",
  "version": "0.1.0",
  "identifier": "dev.folder-sync.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "folder-sync",
        "width": 420,
        "height": 560,
        "resizable": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "publisher": "BAM Robotics",
    "category": "Utility",
    "shortDescription": "Your folder, on every machine and online",
    "longDescription": "Sign in once; the app makes your folder and keeps it in sync in the background (folder-sync, docs/peps/0006).",
    "externalBin": [
      "binaries/folder-sync"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "folder-sync-desktop.desktop"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
